<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets CloudKit deliver silent pushes so SwiftData mirrors changes between devices
	     promptly. Every other Info.plist key is produced by GENERATE_INFOPLIST_FILE. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Player avatars: the selfie option opens the system camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Take a selfie to use as your player avatar.</string>
	<!-- The app uses only standard HTTPS/ATS encryption, which is exempt from export
	     compliance documentation. Declaring it here skips the question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The turn timer can put a Live Activity countdown on the Lock Screen and in the
	     Dynamic Island. Rendered by the GameToolkitWidgets extension. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- iOS 26+ AlarmKit: lets the timer ring a real system alarm that breaks through
	     silent mode and Focus. Ignored harmlessly on earlier systems. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Game Toolkit rings a real alarm when a timer runs out, even if the app is closed or the phone is silenced.</string>
	<!-- Required for the external-display scoreboard: without multiple-scene support,
	     UIKit never delivers the windowExternalDisplayNonInteractive scene session.
	     Side effect: the app also becomes multi-windowable on iPad, which is fine. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
</dict>
</plist>
