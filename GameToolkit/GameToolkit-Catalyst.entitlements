<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store builds must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- CloudKit talks to Apple's servers, which the sandbox otherwise blocks. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.nathanfennel.Game-Toolkit</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.nathanfennel.Game-Toolkit</string>
</dict>
</plist>
